# Modelo das variáveis de ambiente. Copie para .env (ignorado pelo Git) e preencha.
# O docker-compose.yml e a aplicação leem este mesmo arquivo.
DB_NAME=productivity
DB_PORT=5433
DB_USER=productivity
DB_PASSWORD=troque-esta-senha
# Produção (Neon): URL JDBC completa, que substitui DB_NAME/DB_PORT. Ex.:
#   DB_URL=jdbc:postgresql://ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require
# Conexões simultâneas com o banco no perfil prod (opcional, padrão 5)
#   DB_POOL_SIZE=5

# Endereços do front-end que podem chamar a API pelo navegador, separados por vírgula
# (opcional, padrão http://localhost:5173, o Vite local)
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Segredo de assinatura do JWT: mínimo de 32 caracteres. Gere um aleatório, por exemplo:
#   openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio-com-pelo-menos-32-caracteres
# Validade do token de acesso, em minutos (opcional, padrão 60)
JWT_EXPIRATION_MINUTES=60

# Bot do Telegram (Fase 6). Sem TELEGRAM_BOT_TOKEN o bot fica desligado e o resto da API funciona normalmente.
# Token gerado pelo @BotFather. Nunca versione o valor real.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=tarefanoar_bot
# Produção (webhook): URL pública da API + segredo aleatório que o Telegram devolve em cada chamada.
#   TELEGRAM_WEBHOOK_URL=https://sua-api.exemplo.com/telegram/webhook
#   Gere o segredo com: openssl rand -hex 32
TELEGRAM_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=
